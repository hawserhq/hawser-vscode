{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Explicit, not implicit: TypeScript 7 no longer auto-includes every
    // @types/* package, and "node" must stay on the extension host's Node major.
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
