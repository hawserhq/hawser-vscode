{
  "name": "skrog",
  "displayName": "Skrog",
  "description": "Docker Engine on Windows via WSL2 — see and control the Skrog engine from VS Code: idle/wake status, start/stop, doctor, and more.",
  "version": "0.1.0",
  "publisher": "wslkit",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": { "color": "#2F3B45", "theme": "dark" },
  "repository": {
    "type": "git",
    "url": "https://github.com/wslkit/skrog-vscode"
  },
  "bugs": {
    "url": "https://github.com/wslkit/skrog-vscode/issues"
  },
  "homepage": "https://github.com/wslkit/skrog",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docker",
    "wsl",
    "wsl2",
    "container",
    "engine",
    "skrog"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "skrog.menu", "title": "Skrog: Engine Menu" },
      { "command": "skrog.start", "title": "Skrog: Start Engine" },
      { "command": "skrog.stop", "title": "Skrog: Stop Engine" },
      { "command": "skrog.restart", "title": "Skrog: Restart Engine" },
      { "command": "skrog.doctor", "title": "Skrog: Run Doctor" },
      { "command": "skrog.refresh", "title": "Skrog: Refresh Status" }
    ],
    "configuration": {
      "title": "Skrog",
      "properties": {
        "skrog.path": {
          "type": "string",
          "default": "",
          "description": "Path to skrog.exe. Leave empty to resolve `skrog` on PATH."
        },
        "skrog.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "How often the status bar refreshes engine state, in milliseconds (only while a window is focused)."
        },
        "skrog.notifyTransitions": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the engine idle-stops to free RAM or wakes back up."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run check && npm run build -- --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
